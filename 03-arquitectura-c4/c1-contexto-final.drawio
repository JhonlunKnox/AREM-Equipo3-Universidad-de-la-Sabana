<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram name="C1 - Contexto AS-IS" id="c1-asis">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a-title" value="C1 — Contexto del sistema (AS-IS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="50" y="35" width="850" height="35" as="geometry" /></mxCell>
        <mxCell id="a-sub" value="Mantenimiento del directorio de extensiones — situación actual" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="50" y="72" width="850" height="25" as="geometry" /></mxCell>

        <mxCell id="a-scope" value="ÁMBITO DEL PROCESO ACTUAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F3864;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="720" height="610" as="geometry" /></mxCell>
        <mxCell id="a-system" value="&lt;b&gt;Gestión manual del directorio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conjunto de archivos, revisión humana y coordinación por reuniones. No existe una aplicación con estados y responsabilidades separados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#10233F;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="675" y="335" width="330" height="180" as="geometry" /></mxCell>

        <mxCell id="a-johanna" value="&lt;b&gt;Profesional de Experiencia y Servicio&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Compara, decide y actualiza&lt;/i&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="195" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="a-gestoras" value="&lt;b&gt;Gestoras de servicio&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Consultan y transfieren llamadas&lt;/i&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="570" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="a-tech" value="&lt;b&gt;Analista de Tecnología&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Aprovisiona o libera extensiones&lt;/i&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="335" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="a-user" value="&lt;b&gt;Usuario final&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Llama y espera ser transferido&lt;/i&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="620" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="a-hr" value="&lt;b&gt;Sistema de Desarrollo Humano&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Sistema externo&lt;br&gt;exporta la nómina mensual&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="140" width="300" height="115" as="geometry" /></mxCell>
        <mxCell id="a-pbx" value="&lt;b&gt;PBX institucional&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Sistema externo&lt;br&gt;estado real de las extensiones&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="805" width="300" height="115" as="geometry" /></mxCell>

        <mxCell id="a-e1" value="Descarga nómina" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="a-hr" target="a-system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e2" value="Opera manualmente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="a-johanna" target="a-system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e3" value="Consulta directorio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="a-gestoras" target="a-system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e4" value="Solicitud verbal / Teams" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="a-system" target="a-tech"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e5" value="Confirmación no estructurada o inexistente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B85450;dashed=1;strokeWidth=2;fontColor=#B85450;fontStyle=1;fontSize=11;" edge="1" parent="1" source="a-tech" target="a-system"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="560" /><mxPoint x="840" y="560" /></Array></mxGeometry></mxCell>
        <mxCell id="a-e6" value="Opera" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;fontSize=11;" edge="1" parent="1" source="a-tech" target="a-pbx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e7" value="Llamada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="a-user" target="a-gestoras"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="690" /><mxPoint x="390" y="690" /></Array></mxGeometry></mxCell>
        <mxCell id="a-e8" value="Transfiere" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="a-gestoras" target="a-user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="740" /><mxPoint x="1170" y="740" /></Array></mxGeometry></mxCell>

        <mxCell id="a-note" value="&lt;b style=&quot;color:#B85450&quot;&gt;Problema estructural&lt;/b&gt;&lt;br&gt;&lt;br&gt;El archivo del directorio actúa como base de datos, interfaz, registro de estados y producto final. El PBX no está integrado y la confirmación de Tecnología no regresa al proceso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0EF;strokeColor=#E8B4B0;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="805" width="590" height="150" as="geometry" /></mxCell>
        <mxCell id="a-legend" value="&lt;b&gt;Convenciones C4&lt;/b&gt;&lt;br&gt;Amarillo: persona · Azul: sistema de interés · Gris: sistema externo · Línea roja discontinua: relación ausente o no controlada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#C9CFDC;align=left;verticalAlign=middle;spacing=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="815" width="510" height="120" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="C1 - Contexto TO-BE" id="c1-tobe">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t-title" value="C1 — Contexto del sistema objetivo (TO-BE)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="50" y="35" width="950" height="35" as="geometry" /></mxCell>
        <mxCell id="t-sub" value="Gestión institucional del directorio de extensiones sobre Microsoft 365" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="50" y="72" width="950" height="25" as="geometry" /></mxCell>

        <mxCell id="t-system" value="&lt;b&gt;Gestión institucional del directorio de extensiones&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recibe la nómina, compara fuentes, registra novedades, gestiona solicitudes y mantiene el directorio consultable con estados y trazabilidad." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#10233F;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="480" height="220" as="geometry" /></mxCell>

        <mxCell id="t-johanna" value="&lt;b&gt;Profesional de Experiencia y Servicio&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Carga, valida excepciones y administra el proceso&lt;/i&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="180" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="t-gestoras" value="&lt;b&gt;Gestoras de servicio&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Consultan el directorio vigente&lt;/i&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="640" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="t-jefe" value="&lt;b&gt;Jefe de la unidad&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Consulta seguimiento y excepciones&lt;/i&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="410" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="t-tech" value="&lt;b&gt;Analista de Tecnología&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Recibe y confirma solicitudes estructuradas&lt;/i&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="340" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="t-user" value="&lt;b&gt;Usuario final&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Recibe atención y transferencia&lt;/i&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="650" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="t-hr" value="&lt;b&gt;Sistema de Desarrollo Humano&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Externo · exporta nómina mensual&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="380" height="100" as="geometry" /></mxCell>
        <mxCell id="t-pbx" value="&lt;b&gt;PBX institucional&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Externo · Tecnología ejecuta el aprovisionamiento&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="790" width="380" height="100" as="geometry" /></mxCell>
        <mxCell id="t-m365" value="&lt;b&gt;Microsoft 365 / Entra ID&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;Plataforma externa de identidad, almacenamiento, automatización y colaboración&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F0FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="160" width="390" height="110" as="geometry" /></mxCell>

        <mxCell id="t-e1" value="Carga y valida" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-johanna" target="t-system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e2" value="Consulta directorio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-gestoras" target="t-system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e3" value="Consulta seguimiento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-jefe" target="t-system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e4" value="Importa archivo autorizado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-hr" target="t-system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e5" value="Envía solicitud con ID" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-system" target="t-tech"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e6" value="Confirma resultado y observación" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="t-tech" target="t-system"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="585" /><mxPoint x="840" y="585" /></Array></mxGeometry></mxCell>
        <mxCell id="t-e7" value="Ejecuta cambio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;fontSize=11;" edge="1" parent="1" source="t-tech" target="t-pbx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e8" value="Usa identidad y servicios" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A86C5;fontSize=11;" edge="1" parent="1" source="t-system" target="t-m365"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e9" value="Llamada y transferencia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;startArrow=classic;endArrow=classic;fontSize=11;" edge="1" parent="1" source="t-user" target="t-gestoras"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="735" /><mxPoint x="420" y="735" /></Array></mxGeometry></mxCell>

        <mxCell id="t-note" value="&lt;b&gt;Límite de la solución&lt;/b&gt;&lt;br&gt;&lt;br&gt;No modifica RH ni el PBX. La nómina conserva su latencia de origen. El sistema coordina, registra y confirma; Tecnología continúa ejecutando el cambio técnico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#E08000;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="850" width="520" height="140" as="geometry" /></mxCell>
        <mxCell id="t-pending" value="&lt;b&gt;Validaciones previas&lt;/b&gt;&lt;br&gt;Permisos de SharePoint · licencias y conectores · política DLP · grupo receptor de Tecnología · catálogo de unidades y cargos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#C9CFDC;align=left;verticalAlign=top;spacing=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="850" width="500" height="140" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
