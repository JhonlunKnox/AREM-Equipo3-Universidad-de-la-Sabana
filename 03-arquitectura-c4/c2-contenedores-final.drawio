        <mxCell id="t-title" value="C2 — Contenedores de la arquitectura objetivo (TO-BE)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="50" y="35" width="1050" height="35" as="geometry" /></mxCell>
        <mxCell id="t-sub" value="Diseño base con servicios Microsoft 365 y conectores estándar" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="50" y="72" width="1050" height="25" as="geometry" /></mxCell>

