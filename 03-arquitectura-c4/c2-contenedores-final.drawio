        <mxCell id="t-dir" value="&lt;b&gt;C03 · DirectorioExtensiones&lt;/b&gt;&lt;br&gt;&lt;i&gt;Microsoft Lists&lt;/i&gt;&lt;br&gt;Fuente única del directorio operativo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2FB;strokeColor=#1F3864;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="220" width="300" height="120" as="geometry" /></mxCell>

        <mxCell id="t-cat" value="&lt;b&gt;C04 · Catálogos maestros&lt;/b&gt;&lt;br&gt;&lt;i&gt;Microsoft Lists&lt;/i&gt;&lt;br&gt;Unidades, alias, cargos y elegibilidad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2FB;strokeColor=#1F3864;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="455" width="290" height="120" as="geometry" /></mxCell>
