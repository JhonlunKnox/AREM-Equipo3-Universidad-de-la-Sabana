        <mxCell id="a-e5" value="Consulta solo lectura" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="a-gest" target="a-dir"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e6" value="Agenda y revisa" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#4A86C5;fontSize=11;" edge="1" parent="1" source="a-prof" target="a-teams"><mxGeometry relative="1" as="geometry" /></mxCell>
