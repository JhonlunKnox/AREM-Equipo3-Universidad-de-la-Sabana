        <mxCell id="t-lib" value="&lt;b&gt;C01 · Biblioteca EntradasNomina&lt;/b&gt;&lt;br&gt;&lt;i&gt;SharePoint Online&lt;/i&gt;&lt;br&gt;Recibe archivos mensuales y conserva versiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F0FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="290" height="120" as="geometry" /></mxCell>
