        <mxCell id="a-rh" value="&lt;b&gt;Sistema RH&lt;/b&gt;&lt;br&gt;Externo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="230" height="95" as="geometry" /></mxCell>
