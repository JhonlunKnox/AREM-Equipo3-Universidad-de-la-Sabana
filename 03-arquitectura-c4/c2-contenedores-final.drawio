      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="a-title" value="C2 — Contenedores y artefactos actuales (AS-IS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=22;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="50" y="35" width="950" height="35" as="geometry" /></mxCell>
        <mxCell id="a-sub" value="El proceso depende de archivos en OneDrive y coordinación no estructurada" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="50" y="72" width="950" height="25" as="geometry" /></mxCell>

        <mxCell id="a-bound" value="GESTIÓN MANUAL DEL DIRECTORIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F3864;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="350" y="150" width="1080" height="650" as="geometry" /></mxCell>
        <mxCell id="a-file" value="&lt;b&gt;Archivo de nómina&lt;/b&gt;&lt;br&gt;&lt;i&gt;Excel&lt;/i&gt;&lt;br&gt;Exportación mensual mes vencido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#E08000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="230" width="250" height="115" as="geometry" /></mxCell>
        <mxCell id="a-human" value="&lt;b&gt;Conciliación manual&lt;/b&gt;&lt;br&gt;&lt;i&gt;Actividad humana&lt;/i&gt;&lt;br&gt;≈ 6.400 filas para 5–10 novedades" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDF0EF;strokeColor=#B85450;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="220" width="270" height="140" as="geometry" /></mxCell>
        <mxCell id="a-dir" value="&lt;b&gt;Directorio de extensiones&lt;/b&gt;&lt;br&gt;&lt;i&gt;Libro Excel en OneDrive&lt;/i&gt;&lt;br&gt;Datos, estados e interfaz en un solo archivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2FB;strokeColor=#1F3864;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="225" width="250" height="125" as="geometry" /></mxCell>
        <mxCell id="a-teams" value="&lt;b&gt;Teams / reunión&lt;/b&gt;&lt;br&gt;&lt;i&gt;Coordinación&lt;/i&gt;&lt;br&gt;Solicitud verbal y revisión conjunta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F0FF;strokeColor=#4A86C5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="260" height="115" as="geometry" /></mxCell>
        <mxCell id="a-pending" value="&lt;b&gt;Marca “pendiente”&lt;/b&gt;&lt;br&gt;&lt;i&gt;Estado en una celda&lt;/i&gt;&lt;br&gt;Sin responsable, vencimiento ni transición de salida" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0EF;strokeColor=#B85450;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="515" width="290" height="125" as="geometry" /></mxCell>

