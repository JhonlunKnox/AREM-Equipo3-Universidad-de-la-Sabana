        <mxCell id="a-e9" value="Estado queda en el archivo" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#B85450;fontSize=11;" edge="1" parent="1" source="a-pending" target="a-dir"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e10" value="Aprovisiona / libera" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#6B7280;fontSize=11;" edge="1" parent="1" source="a-tech" target="a-pbx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e11" value="Sin retorno" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#B85450;dashed=1;strokeWidth=2;fontColor=#B85450;fontStyle=1;fontSize=11;" edge="1" parent="1" source="a-pbx" target="a-pending"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a-note" value="&lt;b&gt;Problemas de contenedores&lt;/b&gt;&lt;br&gt;&lt;br&gt;• No hay almacén institucional tipado.&lt;br&gt;• No existe artefacto de novedades.&lt;br&gt;• La coordinación no conserva un estado transaccional.&lt;br&gt;• La verdad técnica del PBX no regresa al directorio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#C9CFDC;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="845" width="620" height="160" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

