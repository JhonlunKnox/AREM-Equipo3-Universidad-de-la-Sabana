        <mxCell id="t-rh" value="&lt;b&gt;Sistema RH&lt;/b&gt;&lt;br&gt;Externo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="t-pbx" value="&lt;b&gt;PBX&lt;/b&gt;&lt;br&gt;Externo · sin integración directa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1810" y="770" width="230" height="95" as="geometry" /></mxCell>

        <mxCell id="t-e1" value="Archivo mensual" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#E08000;fontSize=11;" edge="1" parent="1" source="t-rh" target="t-lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e2" value="Carga" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-prof" target="t-lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e3" value="Lee última versión" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-lib" target="t-pq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e4" value="Lee fuente vigente" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-dir" target="t-pq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e5" value="Aplica equivalencias" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-cat" target="t-pq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e6" value="Produce excepciones" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#E08000;fontSize=11;" edge="1" parent="1" source="t-pq" target="t-nov"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e7" value="Crea solicitud aprobada" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-nov" target="t-sol"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e8" value="Observa cambios" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="t-sol" target="t-flow"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e9" value="Notifica y espera respuesta" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="t-flow" target="t-ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e10" value="Responde" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#4A86C5;fontSize=11;" edge="1" parent="1" source="t-tech" target="t-ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e11" value="Registra confirmación" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="t-flow" target="t-sol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="660" /><mxPoint x="1410" y="660" /></Array></mxGeometry></mxCell>
        <mxCell id="t-e12" value="Actualiza estado validado" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="t-flow" target="t-dir"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="650" /><mxPoint x="1630" y="650" /><mxPoint x="1630" y="280" /></Array></mxGeometry></mxCell>
        <mxCell id="t-e13" value="Consulta" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#1F3864;fontSize=11;" edge="1" parent="1" source="t-gest" target="t-dir"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285" y="930" /><mxPoint x="1660" y="930" /><mxPoint x="1660" y="280" /></Array></mxGeometry></mxCell>
        <mxCell id="t-e14" value="Autentica y autoriza" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#4A86C5;fontSize=11;" edge="1" parent="1" source="t-id" target="t-flow"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e15" value="Ejecuta cambio" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#6B7280;fontSize=11;" edge="1" parent="1" source="t-tech" target="t-pbx"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="t-note1" value="&lt;b&gt;Automatización base&lt;/b&gt;&lt;br&gt;El cruce se actualiza de forma guiada en Power Query. Los flujos automatizan notificación, respuesta, estados y vencimientos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#E08000;align=left;verticalAlign=top;spacing=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1110" width="500" height="115" as="geometry" /></mxCell>
        <mxCell id="t-note2" value="&lt;b&gt;Control de seguridad&lt;/b&gt;&lt;br&gt;Las notificaciones transportan ID y enlace. El detalle permanece en las listas protegidas; la nómina no se entrega a Gestoras ni a Tecnología." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#C9CFDC;align=left;verticalAlign=top;spacing=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="1110" width="520" height="115" as="geometry" /></mxCell>
        <mxCell id="t-note3" value="&lt;b&gt;Pendiente de validación&lt;/b&gt;&lt;br&gt;Permisos · licencias · conectores · DLP · propietario institucional · plazos y escalamiento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0EF;strokeColor=#E8B4B0;align=left;verticalAlign=top;spacing=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="1110" width="500" height="115" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
