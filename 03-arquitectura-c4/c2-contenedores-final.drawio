        <mxCell id="t-prof" value="&lt;b&gt;Profesional de Experiencia y Servicio&lt;/b&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="285" width="230" height="100" as="geometry" /></mxCell>
