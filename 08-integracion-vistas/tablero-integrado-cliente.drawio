g" value="Leyenda: borde verde grueso + [NUEVO] = TO-BE del Taller 7 (soluciones S1-S3, paquetes WP1-WP3, brechas G01-G14), con IDs de detalle de 03-C4 y 04-Infraestructura; gris punteado = sistema externo fuera de alcance o AS-IS que se retira; flecha verde = conexión nueva TO-BE; flecha negra = conexión existente; flecha roja punteada = control de seguridad (IDs de 05-STRIDE y 06-Normatividad). Datos de ejemplo ficticios; no se publica nómina ni directorio reales." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#999999;fillColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="1860" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c2" name="2. Hilo Conciliación mensual"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2-t" value="Hilo 1 — S2 Conciliación automatizada (G01, G05, G08, G13 · B1, B4)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1108" height="40" as="geometry"/></mxCell><mxCell id="c2-neg" value="Vista de Negocio" style="swimlane;horizontal=0;startSize=40;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;html=1;swimlaneFillColor=#fff2cc;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1108" height="150" as="geometry"/></mxCell><mxCell id="c2-dh" value="Publicación de nómina mes vencido (Desarrollo Humano)&#xa;(externo)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;" vertex="1" parent="c2-neg"><mxGeometry x="58" y="40" width="170" height="70" as="geometry"/></mxCell><mxCell id="c2-p2" value="P2 Conciliación por excepciones (WP2)&#xa;[NUEVO]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=